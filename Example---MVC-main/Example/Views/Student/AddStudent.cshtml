@model Example.Models.ViewModel.VMStudent
<h2>Thêm sinh viên mới</h2>
<form asp-controller="Student" asp-action="AddStudent" method="post">
    <div class="form-group">
        <label>Họ tên:</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Ngày sinh:</label>
        <input asp-for="Birth" class="form-control" type="date" />
        <span asp-validation-for="Birth" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>MSSV:</label>
        <input asp-for="Mssv" class="form-control" />
        <span asp-validation-for="Mssv" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Giới tính:</label>
        @Html.RadioButton("Gender", "male") Nam
        @Html.RadioButton("Gender", "female") Nữ
    </div>
    <div class="form-group">
        <label>URL Ảnh:</label>
        <input asp-for="ImgUrl" class="form-control" />
    </div>
    <div class="form-group">
        <label>Mô tả:</label>
        <input asp-for="Description" class="form-control" />
    </div>
    <input type="submit" value="Thêm" class="btn btn-primary mt-2" />
</form>