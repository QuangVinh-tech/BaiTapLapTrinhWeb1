@model IEnumerable<Example.Models.Domain.Student>

@{
    ViewData["Title"] = "Danh sách sinh viên";
    var i = 1;
}

<style>
    table th, table td {
        text-align: center;
        vertical-align: middle;
    }

    img {
        border-radius: 8px;
    }

    .action-btn {
        margin: 2px;
    }
</style>

@if (TempData["successMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["successMessage"]
    </div>
}

<h2 class="mb-3">Thông tin sinh viên lớp K21</h2>


@using (Html.BeginForm("GetAll", "Student", FormMethod.Get))
{
    <div class="mb-3">
        <input type="text" name="SearchString" class="form-control d-inline w-25"
               placeholder="Nhập từ khóa..." />

        <label class="ms-2">
            <input type="radio" name="type" value="Name" /> Theo tên
        </label>

        <label class="ms-2">
            <input type="radio" name="type" value="Mssv" /> Theo MSSV
        </label>

        <button type="submit" class="btn btn-primary btn-sm ms-2">
            Tìm kiếm
        </button>
    </div>
}

@if (User.IsInRole("Admin") || User.IsInRole("Editor"))
{
    <a asp-controller="Student" asp-action="AddStudent"
       class="btn btn-success mb-3">
        + Thêm sinh viên
    </a>
}


<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>STT</th>
            <th>Tên</th>
            <th>Tuổi</th>
            <th>Giới tính</th>
            <th>Hình ảnh</th>
            <th>Chi tiết</th>
            <th>Chỉnh sửa</th>
            <th>Xóa</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@i</td>
                <td>@item.Name</td>
                <td>
                    @(DateTime.Now.Year - item.Birth.Year -
                                    (DateTime.Now < item.Birth.ToDateTime(TimeOnly.MinValue)
                                    .AddYears(DateTime.Now.Year - item.Birth.Year) ? 1 : 0))
            </td>
                <td>@(item.Gender ? "Nam" : "Nữ")</td>


                <td>
                    <img src="@item.ImgUrl" height="80" />
                </td>

                
                <td>
                    <a asp-action="GetStudentById" asp-route-id="@item.Id"
                       class="btn btn-primary btn-sm">
                        Chi tiết
                    </a>
                </td>

                
                <td>
                    <a asp-action="EditStudentById" asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">
                        Chỉnh sửa
                    </a>
                </td>

                
                <td>
                    <a asp-action="DelStudentById" asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Bạn có chắc muốn xóa không?');">
                        Xóa
                    </a>
                </td>
            </tr>

                i++;
        }
    </tbody>
</table>