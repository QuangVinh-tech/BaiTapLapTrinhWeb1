@model Example.Models.ViewModel.VMStudent
@{
    var errorMessage = TempData["errorMessage"]?.ToString();
}
<h3>Chỉnh sửa thông tin sinh viên:</h3>
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
<form asp-controller="Student" asp-action="EditStudentById" method="post">
    <div class="form-group">
        <label>Họ tên:</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Ngày sinh:</label>
        <input asp-for="Birth" class="form-control" type="date" />
        <span asp-validation-for="Birth" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>MSSV:</label>
        <input asp-for="Mssv" class="form-control" />
        <span asp-validation-for="Mssv" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Giới tính:</label>
        @Html.RadioButton("Gender", "male") Male
        @Html.RadioButton("Gender", "female") Female
        <span asp-validation-for="Gender" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Mô tả:</label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Image URL:</label>
        <input asp-for="ImgUrl" class="form-control" />
        <span asp-validation-for="ImgUrl" class="text-danger"></span>
    </div>
    <input type="Submit" value="Finish" class="btn btn-primary" />
</form>